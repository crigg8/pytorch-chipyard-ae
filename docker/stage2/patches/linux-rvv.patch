diff --git a/arch/riscv/include/asm/vector.h b/arch/riscv/include/asm/vector.h
index c5ee07b3df07..3b9db1fcce6f 100644
--- a/arch/riscv/include/asm/vector.h
+++ b/arch/riscv/include/asm/vector.h
@@ -187,11 +187,15 @@ static inline void riscv_v_vstate_restore(struct task_struct *task,
 static inline void __switch_to_vector(struct task_struct *prev,
 				      struct task_struct *next)
 {
-	struct pt_regs *regs;
-
-	regs = task_pt_regs(prev);
-	riscv_v_vstate_save(prev, regs);
-	riscv_v_vstate_restore(next, task_pt_regs(next));
+	/*
+	 * PyTorch-Chipyard AE workaround for the Saturn target.  RVV workload
+	 * threads are pinned one per hart, so leave their vector state resident
+	 * instead of running the LMUL=8 save/restore sequence at every task
+	 * switch.  This is not a general-purpose Linux context-switch policy:
+	 * no other userspace RVV task may share or migrate onto these harts.
+	 */
+	(void)prev;
+	(void)next;
 }
 
 void riscv_v_vstate_ctrl_init(struct task_struct *tsk);
diff --git a/arch/riscv/kernel/traps.c b/arch/riscv/kernel/traps.c
index fae8f610d867..781710b2680f 100644
--- a/arch/riscv/kernel/traps.c
+++ b/arch/riscv/kernel/traps.c
@@ -312,7 +312,13 @@ asmlinkage __visible __trap_section void do_trap_ecall_u(struct pt_regs *regs)
 		regs->epc += 4;
 		regs->orig_a0 = regs->a0;
 
-		riscv_v_vstate_discard(regs);
+		/*
+		 * jseo: Saturn can intermittently lose VS while executing the
+		 * LMUL=8 syscall discard sequence and trap on vmv.v.i v24, -1.
+		 * Skip the syscall clobber.  The AE-only task-switch workaround is
+		 * documented separately in arch/riscv/include/asm/vector.h.
+		 */
+		/* riscv_v_vstate_discard(regs); */
 
 		syscall = syscall_enter_from_user_mode(regs, syscall);
 
