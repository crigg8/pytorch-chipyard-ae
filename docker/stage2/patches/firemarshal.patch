 #!/usr/bin/env python3
+import os
+import pathlib
 import sys
+
+_THIS_FILE = pathlib.Path(__file__).resolve()
+_CHIPYARD_ROOT = _THIS_FILE.parents[2]
+_CONDA_PREFIX = _CHIPYARD_ROOT / ".conda-env"
+_CONDA_PYTHON = _CONDA_PREFIX / "bin" / "python"
+_RISCV_TOOLCHAIN_BIN = _CONDA_PREFIX / "riscv-tools" / "bin"
+
+
+def _bootstrap_local_conda():
+    if not _CONDA_PYTHON.exists():
+        return
+
+    current_python = pathlib.Path(sys.executable).resolve()
+    target_python = _CONDA_PYTHON.resolve()
+    path_entries = os.environ.get("PATH", "").split(os.pathsep)
+
+    if current_python == target_python and str(_RISCV_TOOLCHAIN_BIN) in path_entries:
+        return
+
+    new_env = os.environ.copy()
+    new_path = [str(_RISCV_TOOLCHAIN_BIN), str(_CONDA_PREFIX / "bin")]
+    if new_env.get("PATH"):
+        new_path.append(new_env["PATH"])
+    new_env["PATH"] = os.pathsep.join(new_path)
+    new_env.setdefault("CONDA_PREFIX", str(_CONDA_PREFIX))
+    new_env.setdefault("CONDA_DEFAULT_ENV", str(_CONDA_PREFIX))
+
+    os.execvpe(
+        str(_CONDA_PYTHON),
+        [str(_CONDA_PYTHON), str(_THIS_FILE), *sys.argv[1:]],
+        new_env,
+    )
+
+
+_bootstrap_local_conda()
+
 import argparse
